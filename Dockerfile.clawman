# Clawman Control Plane — Docker image
# Usage: gcloud builds submit --config cloudbuild.yaml .

FROM node:22-slim AS base
WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy everything (filtered by .gcloudignore / .dockerignore)
COPY . .

# Install dependencies + build
RUN pnpm install --no-frozen-lockfile && pnpm build

# Runtime stage
FROM node:22-slim AS runtime
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# Create clawman directories
RUN mkdir -p /root/.clawman/config /root/.clawman/governance/audit /root/.clawman/governance/usage /root/.clawman/memory

COPY --from=base /app/dist/ ./dist/
COPY --from=base /app/node_modules/ ./node_modules/
COPY --from=base /app/package.json ./
COPY --from=base /app/skills/ ./skills/
COPY --from=base /app/ui/ ./ui/

# Default port
EXPOSE 18789

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:18789/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

ENTRYPOINT ["node", "dist/index.js", "gateway", "run", "--bind", "all", "--port", "18789"]
